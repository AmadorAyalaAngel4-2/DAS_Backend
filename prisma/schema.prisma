generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String   @id @default(uuid())
  name        String
  plan          String   @default("FREE")
  isActive    Boolean  @default(true)
  createdAt     DateTime @default(now())
  
  users      User[]
  devices  Device[]
  eventLogs  EventLog[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String
  role      String   @default("OPERATOR") 
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Device {
  id          String   @id @default(uuid())
  hardwareId    String   @unique 
  name      String   
  location   String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  eventLogs   EventLog[]
}

model EventLog {
  id           String   @id @default(uuid())
  color        String   
  action       String   
  createdAt    DateTime @default(now())
  originIp     String?  
  
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id])
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}
